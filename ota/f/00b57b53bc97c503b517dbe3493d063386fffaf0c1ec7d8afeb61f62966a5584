    <div class="topbar"><span class="coins"><i data-ic="coin" data-s="16"></i> <span class="coinVal">0</span></span><span class="tb-r"><button class="gear" id="openHow" data-ta="how" aria-label="Nasıl oynanır"><i data-ic="help" data-s="20"></i></button><button class="gear" id="openSet" data-ta="settings" aria-label="Ayarlar"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h8M18 7h2M4 12h2M12 12h8M4 17h10M20 17h0"/><circle cx="15" cy="7" r="2.4"/><circle cx="9" cy="12" r="2.4"/><circle cx="17" cy="17" r="2.4"/></svg></button><button class="shopbtn" id="openShop"><i data-ic="cart" data-s="17"></i> <span data-t="shop"></span></button></span></div>
    <h1 data-t="brand">TAZYİK</h1>
    </div>
    <div class="sub" data-t="sub"></div>
    <p class="save-note hidden" id="saveNote" role="status"></p>
    <button class="play hidden" id="playBtn"></button>
    <button class="daily ota hidden" id="otaBtn"><span class="di"><i data-ic="drop" data-s="22"></i></span><span><span class="ot"></span><small></small></span><span class="go">›</span></button>
    <button class="daily hidden" id="dailyBtn"></button>
    <button class="daily ord hidden" id="ordBtn"></button>
    <button class="daily free hidden" id="freeBtn"></button>
    <button class="daily cam hidden" id="camBtn"></button>
    <div id="levels"></div>
  </div>
  <div class="hidden" id="camScr">
    <canvas id="camCv"></canvas>
    <div class="hud"><button class="btn-ic" id="camBack" aria-label="Menü">‹</button><div class="bar-wrap"><div class="bar-top"><span id="camName"></span><span id="camPct">%0</span></div><div class="bar"><i id="camBar"></i></div><div class="camtip" id="camTip"></div></div><button class="finish-btn" id="camDone" disabled></button></div>
    <div class="tools" id="camTools"></div>
    <div class="modal hidden pause-layer" id="camWin" role="dialog" aria-modal="true"><div class="card"><h2 id="camTitle"></h2><div class="stars" id="camStars"></div><p class="muted" id="camRes"></p><p class="story" id="camStory"></p><div class="row"><button class="b s" id="camMenu"></button><button class="b p hidden" id="camNext"></button><button class="b p" id="camAgain"></button></div></div></div>
  </div>

  <div class="screen hidden" id="defScr">
    <div class="topbar"><button class="shopbtn" id="closeDef" data-t="back">‹ Geri</button></div>
    <h1 style="font-size:30px" data-t="defter"></h1>
    <div class="how" id="defList"></div>
  </div>

  <div class="screen hidden" id="howScr">
    <div class="topbar"><button class="shopbtn" id="closeHow" data-t="back">‹ Geri</button></div>
    <h1 style="font-size:30px" data-t="how"></h1>
    <div class="how" id="howList"></div>
  </div>

  <div class="screen hidden" id="freeScr">
