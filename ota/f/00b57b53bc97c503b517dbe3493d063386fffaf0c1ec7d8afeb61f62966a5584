    <div class="grid fgrid" id="freeGrid"></div>
  </div>
  <div class="screen hidden" id="shopScr">
    <div class="topbar"><button class="shopbtn" id="closeShop" data-t="back">‹ Geri</button><span class="coins"><i data-ic="coin" data-s="16"></i> <span class="coinVal">0</span></span></div>
    <h1 style="font-size:34px" data-t="shopT"></h1>
    <div class="sub" data-t="shopSub"></div>
    <div class="shop" id="shopList"></div>
  </div>

  <div class="modal hidden" id="fail">
    <div class="card">
      <h2 data-t="failT"></h2>
      <div class="muted" id="failInfo" data-t="failD"></div>
      <div class="row"><button class="b p" id="adWater"><i data-ic="drop" data-s="16"></i> <span data-t="freeWater"></span></button></div>
      <div class="row"><button class="b s" id="failMenu" data-t="menu"></button><button class="b s" id="failRetry" data-t="retry"></button></div>
    </div>
  </div>
  <div class="modal hidden" id="win">
    <div class="card">
      <h2 data-t="winT"></h2>
      <div class="stars" id="stars"></div>
      <div class="earn" id="earn"></div>
      <div class="muted" id="winInfo"></div>
      <p class="story" id="winStory"></p>
      <div class="row"><button class="b s" id="beforeBtn" data-t="before"></button><button class="b s" id="shareBtn" style="flex:none;padding:13px 16px"><i data-ic="share" data-s="16"></i> <span data-t="share"></span></button></div>
      <div class="row">
        <button class="b s" id="menuBtn" data-t="menu"></button>
        <button class="b s" id="retryBtn" data-t="retry"></button>
        <button class="b p" id="nextBtn" data-t="next"></button>
      </div>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="setScreen" role="dialog" aria-modal="true" aria-labelledby="setTitle">
