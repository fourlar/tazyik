      <div class="row"><button class="b s" id="setHaptic">Titreşim</button></div>
      <div class="row"><button class="b s" id="setLang"></button></div>
      <div class="row"><button class="b s" id="setPriv"></button></div>
      <div class="row"><button class="b s" id="setSupport"></button></div>
      <div class="row"><button class="b p" id="setClose" data-t="ok"></button></div>
      <div class="row"><button class="b s danger" id="setReset">İlerlemeyi sıfırla</button></div>
      <p class="muted ver">Tazyik 1.0.0</p>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="ordScreen" role="dialog" aria-modal="true" aria-labelledby="ordWho">
    <div class="card"><div class="muted" data-t="ordT"></div><h2 id="ordWho"></h2>
      <p class="priv" id="ordAsk"></p><div class="ordjobs" id="ordJobs"></div>
      <div class="row"><button class="b p" id="ordGo"></button></div>
      <div class="row"><button class="b s" id="ordDef" data-t="defter"></button><button class="b s" id="ordClose" data-t="ok"></button></div>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="ordDone" role="dialog" aria-modal="true" aria-labelledby="odWho">
    <div class="card"><div class="muted" data-t="ordDone"></div><h2 id="odWho"></h2>
      <img class="odimg" id="odImg" alt=""><p class="priv" id="odThx"></p><div class="earn" id="odEarn"></div>
      <div class="row"><button class="b s hidden" id="odShare" style="flex:none;padding:13px 16px"><i data-ic="share" data-s="16"></i> <span data-t="share"></span></button><button class="b p" id="odOk" data-t="ok"></button></div>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="hikCard" role="dialog" aria-modal="true" aria-labelledby="hkT">
    <div class="card"><div class="muted" id="hkTop"></div><h2 id="hkT"></h2>
      <canvas class="hkcv" id="hkCv" width="640" height="400"></canvas><p class="priv" id="hkD"></p>
      <div class="row"><button class="b s" id="hkDef" data-t="defter"></button><button class="b p" id="hkOk" data-t="ok"></button></div>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="privScreen" role="dialog" aria-modal="true" aria-labelledby="privTitle">
    <div class="card"><h2 id="privTitle" data-t="privacy"></h2>
      <p class="muted priv" data-t="priv0"></p>
      <ul class="muted priv"><li data-t="priv1"></li><li data-t="priv2"></li><li data-t="priv3"></li><li data-t="priv4"></li></ul>
      <div class="row"><button class="b p" id="privClose" data-t="ok"></button></div>
    </div>
  </div>
  <div class="modal hidden pause-layer" id="langScreen" role="dialog" aria-modal="true">
    <div class="card"><h2 data-t="lang"></h2><div class="langs" id="langList"></div></div>
  </div>
  <div class="modal hidden pause-layer" id="pauseScreen" role="dialog" aria-modal="true" aria-labelledby="pauseTitle">
    <div class="card"><h2 id="pauseTitle" data-t="paused"></h2>
      <div class="row"><button class="b p" id="resume" data-t="resume"></button><button class="b s" id="pauseMenu" data-t="menu"></button></div>
      <div class="row"><button class="b s" id="mute">Ses</button></div>
    </div>
  </div>
</div></div>

</body>
