    <div class="bar-wrap">
      <div class="bar-top"><span id="lvName">—</span><span class="bt-r"><span id="starNow"></span><span><span id="pct">0</span>%</span></span></div>
      <div class="bar"><i id="barFill"></i></div>
      <div class="minis">
        <span id="starTxt"></span>
        <div class="mini hidden" id="waterRow"><i data-ic="drop" data-s="13"></i><div class="bar"><i id="waterFill"></i></div></div>
        <div class="mini hidden" id="sudRow"><span id="sudIc"><i data-ic="drop" data-s="13"></i></span><div class="bar"><i id="sudFill"></i></div><span id="sudTxt"></span></div>
        <div class="mini hidden" id="heatRow"><i data-ic="flame" data-s="13"></i><div class="bar"><i id="heatFill"></i></div></div>
      </div>
    </div>
    <div class="finish-row hidden" id="finishRow"><button class="finish-btn" id="finishBtn" disabled data-t="finish">Bitir</button></div>
    <span class="hidden"><span id="time"></span><i id="starFill"></i></span>
  </div>
  <div class="tools hidden" id="tools"></div>
  <div class="hint hidden" id="hint"><i data-ic="touch" data-s="20"></i> <span data-t="hint0"></span></div>
  <div class="hik hidden" id="hik" aria-live="polite"></div>
  <div class="tip hidden" id="tip"></div>
  <div class="warn hidden" id="warn"></div>

  <div class="screen" id="menu">
